    "./engine": "./src/engine.js",
    "./plugin": "./src/plugin/runtime.js"
  },
  "main": "./src/index.js",
  "files": [
    "src",
    "agents",
    "docs",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "live": "node scripts/live-check.mjs",
    "install-config": "node scripts/install.mjs"
  },
  "keywords": [
    "opencode",
    "plugin",
    "agent",
    "swarm",
    "orchestration",
    "self-improvement"
